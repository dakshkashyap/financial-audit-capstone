  "rules": [
    {
      "rule_id": "I01_current_noncurrent_asset_misclass",
      "error_type": "Misclassification",
      "statements": [
        "BalanceSheet"
      ],
      "eligible_concepts": [
        "ifrs-full:Inventories",
        "ifrs-full:TradeAndOtherCurrentReceivables",
        "ifrs-full:CurrentTradeReceivables"
      ],
      "injection": {
        "op": "move_row",
        "from_section": "CurrentAssets",
        "to_section": "NoncurrentAssets",
        "recompute": true
      },
      "citation": {
        "asc": "IAS 1.66",
        "citable": true,
        "policy_clause": "presentation",
        "citation_tier": "expert-authored-UNVALIDATED",
        "rationale": "IAS 1.66 lists when an asset is current, including assets realised or consumed in the normal operating cycle (inventories, trade receivables). Placing one in non-current assets violates it. IAS 2 and IFRS 9 measure the asset; they do not assign the section."
      },
      "us_gaap_counterpart": "R01",
      "status": "ready",
      "expected_judgement": "Incorrect"
    },
    {
      "rule_id": "I02_operating_cycle_liability_misclass",
      "error_type": "Misclassification",
      "statements": [
        "BalanceSheet"
      ],
      "eligible_concepts": [
        "ifrs-full:TradeAndOtherCurrentPayables",
        "ifrs-full:AccrualsClassifiedAsCurrent"
      ],
      "injection": {
        "op": "move_row",
        "from_section": "CurrentLiabilities",
        "to_section": "NoncurrentLiabilities",
        "recompute": true
      },
      "citation": {
        "asc": "IAS 1.70",
        "citable": true,
        "policy_clause": "presentation",
        "citation_tier": "expert-authored-UNVALIDATED",
        "rationale": "IAS 1.70: trade payables and accruals for employee and other operating costs are part of working capital used in the normal operating cycle and are current even if due after twelve months. Alternative a reviewer may prefer: IAS 1.69(a)."
      },
      "us_gaap_counterpart": "R02",
      "status": "ready",
      "expected_judgement": "Incorrect"
    },
    {
      "rule_id": "I03_noncurrent_debt_presented_current",
      "error_type": "Misclassification",
