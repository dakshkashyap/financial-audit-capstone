      "citation": {
        "asc": "IAS 1.69",
        "citable": true,
        "policy_clause": "presentation",
        "citation_tier": "expert-authored-UNVALIDATED",
        "rationale": "With no breach, demand or maturity fact in the record, the entity has the right at the end of the reporting period to defer settlement for at least twelve months, so IAS 1.69(d) does not make the borrowing current (IAS 1.72A-72B detail the right). Presenting it all as current violates IAS 1.69."
      },
      "us_gaap_counterpart": "R03",
      "status": "ready",
      "expected_judgement": "Incorrect"
    },
